# Android emulator (com adb reverse): http://127.0.0.1:3000/api
# Android emulator (sem reverse):       http://10.0.2.2:3000/api
# Android fisico via cabo USB:          http://127.0.0.1:3000/api  (use npm run phone:usb)
# iOS Simulator / Web:                  http://localhost:3000/api
# Celular fisico (mesma Wi-Fi):         http://SEU_IP_LOCAL:3000/api  (use npm run phone)
#
# Produção: use .env.production com HTTPS. Builds release falham se a URL for localhost.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000/api
# Google Sign-In (mesmo projeto: dinoeats.ura@gmail.com)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Observabilidade — deixe em branco para desativar (nenhum crash é enviado sem DSN)
EXPO_PUBLIC_SENTRY_DSN=
