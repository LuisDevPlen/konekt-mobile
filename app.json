{
  "expo": {
    "name": "Dino Eats",
    "slug": "konekt-mobile",
    "scheme": "dinoeats",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/platform-logo.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dinoeats.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.dinoeats.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/platform-logo-adaptive.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withAndroidReleaseSigning",
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.630358177762-ermgfja5ki9699fa56s64dftl87maoqn"
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/platform-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#EA1D2C"
        }
      ],
      "expo-status-bar",
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/platform-logo.png",
          "color": "#EA1D2C",
          "defaultChannel": "messages",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "googleWebClientId": "630358177762-21rdhck17psdgtk9vd4rafomo1vc9134.apps.googleusercontent.com",
      "googleAndroidClientId": "630358177762-0s7vn3h57l2feel8i3p3vabem1m4b49k.apps.googleusercontent.com",
      "googleIosClientId": "630358177762-ermgfja5ki9699fa56s64dftl87maoqn.apps.googleusercontent.com",
      "eas": {
        "projectId": "ef078ac6-86b2-4d3d-8a32-a9ca8d2298fc"
      }
    },
    "owner": "dinoeats"
  }
}
